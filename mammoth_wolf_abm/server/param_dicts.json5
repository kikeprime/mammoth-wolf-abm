{
    "canvas_element": {
        "grid_width": 30,
        "grid_height": 30,
        "canvas_width": 600,
        "canvas_height": 600,
    },
    "chart_list": [
        {"Label": "Number of mammoths", "Color": "brown"},
        {"Label": "Number of dire wolves", "Color": "gray"},
        {"Label": "Ratio of grass patches (%)", "Color": "green"},
    ],
    "params": {
        "width": 30,
        "height": 30,
        "torus": {
            "type": "Checkbox",
            "params": {
                name: "Torus",
                value: true,
                description: "Whether the edges are connected or not.",
            },
        },
        "n_mammoth": {
            "type": "Slider",
            "params": {
                "name": "Initial number of woolly mammoths",
                "value": 20,
                "min_value": 0,
                "max_value": 100,
                "step": 1,
            },
        },
        "n_dire_wolf": {
            "type": "Slider",
            "params": {
                "name": "Initial number of dire wolves",
                "value": 20,
                "min_value": 0,
                "max_value": 100,
                "step": 1,
            },
        },
        "grass_regrow_rate": {
            "type": "Slider",
            "params": {
                "name": "Grass' regrow rate (%)",
                "value": 6,
                "min_value": 0,
                "max_value": 100,
                "step": 1,
            },
        },
        "grass_regrow_rate_boosted": {
            "type": "Slider",
            "params": {
                "name": "Grass' boosted regrow rate (%)",
                "value": 10,
                "min_value": 0,
                "max_value": 100,
                "step": 1,
            },
        },
        "mammoth_ep_gain": {
            "type": "Slider",
            "params": {
                "name": "EP gain for woolly mammoths",
                "value": 5,
                "min_value": 1,
                "max_value": 100,
                "step": 1,
            },
        },
        "mammoth_max_age": {
            "type": "Slider",
            "params": {
                "name": "Maximum age of woolly mammoths (years)",
                "value": 60,
                "min_value": 1,
                "max_value": 100,
                "step": 1,
            },
        },
        "mammoth_reproductive_age": {
            "type": "Slider",
            "params": {
                "name": "Minimum age for reproduction for woolly mammoths (years)",
                "value": 9,
                "min_value": 1,
                "max_value": 100,
                "step": 1,
            },
        },
        "mammoth_gestation_period": {
            "type": "Slider",
            "params": {
                "name": "Gestation period of woolly mammoths (months)",
                "value": 22,
                "min_value": 0,
                "max_value": 100,
                "step": 1,
            },
        },
        "mammoth_birth_interval": {
            "type": "Slider",
            "params": {
                "name": "Birth interval of woolly mammoths (months)",
                "value": 54,
                "min_value": 0,
                "max_value": 100,
                "step": 1,
            },
        },
        "dire_wolf_ep_gain": {
            "type": "Slider",
            "params": {
                "name": "EP gain for dire wolves",
                "value": 5,
                "min_value": 1,
                "max_value": 100,
                "step": 1,
            },
        },
        "dire_wolf_max_age": {
            "type": "Slider",
            "params": {
                "name": "Maximum age of dire wolves (years)",
                "value": 60,
                "min_value": 1,
                "max_value": 100,
                "step": 1,
            },
        },
        "dire_wolf_reproductive_age": {
            "type": "Slider",
            "params": {
                "name": "Minimum age for reproduction for dire wolves (years)",
                "value": 9,
                "min_value": 1,
                "max_value": 100,
                "step": 1,
            },
        },
        "dire_wolf_gestation_period": {
            "type": "Slider",
            "params": {
                "name": "Gestation period of dire wolves (months)",
                "value": 22,
                "min_value": 0,
                "max_value": 100,
                "step": 1,
            },
        },
        "dire_wolf_birth_interval": {
            "type": "Slider",
            "params": {
                "name": "Birth interval of dire wolves (months)",
                "value": 54,
                "min_value": 0,
                "max_value": 100,
                "step": 1,
            },
        },
        "dire_wolf_hunt_success_rate": {
            "type": "Slider",
            "params": {
                "name": "Possibility of successful hunt for dire wolves (%)",
                "value": 14.29,
                "min_value": 0,
                "max_value": 100,
                "step": 1e-2,
            },
        },
        "allow_seed": {
            "type": "Checkbox",
            "params": {
                "name": "Allow Seed",
                "value": true,
            },
        },
        "random_seed": {
            "type": "NumberInput",
            "params": {
                "name": "Random Seed",
                "value": 474,
                "description": "Seed for random number generator functions.",
            },
        },
    },
}
